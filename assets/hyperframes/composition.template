<!doctype html><html lang="en"><head><meta charset="UTF-8"><title>Editable motion study</title>
<style>@font-face{font-family:VideoSans;src:url(public/font.ttf)}*{box-sizing:border-box}body{margin:0;background:#f5f1e8;font-family:VideoSans;color:#141414}#root{position:relative;overflow:hidden;width:1920px;height:1080px}h1{position:absolute;left:120px;top:120px;font-size:120px;letter-spacing:-6px;line-height:1;margin:0;width:1600px}.card{position:absolute;left:210px;top:500px;width:330px;height:230px;background:#141414;color:#f5f1e8;border-radius:24px;padding:32px;font-size:42px;font-weight:bold}.meta{font-size:23px;opacity:.6;margin-bottom:70px}.detail{font-size:32px;opacity:0;margin-top:40px}</style>
</head><body><div id="root" data-composition-id="root" data-start="0" data-duration="6" data-width="1920" data-height="1080" data-fps="60">
<div id="brand" style="position:absolute;left:120px;top:50px;font-size:24px;letter-spacing:3px"></div>
<h1 id="hero-title" class="clip" data-start="0" data-duration="6" data-track-index="1">Find your next tool.</h1>
<div id="cards" class="clip" data-start="0" data-duration="6" data-track-index="2"></div>
</div><!-- LOCAL_AUDIO --><script src="public/gsap.min.js"></script><script>
window.video={ready:false};
fetch('config.json').then(r=>r.json()).then(async c=>{
document.querySelector('#brand').textContent=c.brand;document.title=c.brand+' — motion study';
const root=document.querySelector('#root');root.dataset.duration=c.duration;document.querySelectorAll('.clip').forEach(el=>el.dataset.duration=c.duration);
const cards=document.querySelector('#cards');c.items.forEach((label,i)=>{const el=document.createElement('div');el.className='card';el.id='card-'+i;el.innerHTML='<div class="meta">DISCOVERY / 0'+(i+1)+'</div><div class="name"></div><div class="detail">Category → product → maker</div>';el.querySelector('.name').textContent=label;el.style.left=(210+i*390)+'px';cards.append(el)});
await document.fonts.ready;
const hit=(id,fallback)=>(c.timeline?.events.find(e=>e.id===id)?.frame??fallback)/c.fps;
const tl=gsap.timeline({paused:true});
tl.fromTo('h1',{y:160,opacity:0,clipPath:'inset(100% 0 0 0)'},{y:0,opacity:1,clipPath:'inset(0% 0 0 0)',duration:hit('type',42),ease:'power3.out'},0);
tl.fromTo('.card',{y:400,opacity:0,rotation:-12},{y:0,opacity:1,rotation:0,duration:.65,stagger:.08,ease:'power3.out'},.45);
for(let i=0;i<4;i++)tl.to('#card-'+i,{x:(i%2)*390-i*390,y:Math.floor(i/2)*255-100,duration:.65,ease:'power2.inOut'},hit('aggregate',138)-.65);
tl.to('#card-0,#card-2,#card-3',{opacity:0,scale:.75,duration:.65,ease:'power2.inOut'},hit('filter',198)-.65);
tl.to('#card-1',{x:-190,y:-100,duration:.65,ease:'power2.inOut'},hit('filter',198)-.65);
tl.to('#card-1',{width:1400,height:520,y:-160,backgroundColor:c.accent,color:'#141414',duration:.75,ease:'power2.inOut'},hit('expand',258)-.75);
tl.to('#card-1 .detail',{opacity:1,duration:.3},hit('details',273)-.3);
tl.set({}, {},c.duration);window.__timelines={root:tl};
window.video.timeline=tl;window.video.seek=t=>{tl.seek(t,true);};window.video.ready=true;
});
</script></body></html>
